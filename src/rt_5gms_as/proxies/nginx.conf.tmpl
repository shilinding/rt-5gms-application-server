# likely get replaced by the 5GMS application server.
#

worker_processes 5;
error_log    {error_log_path};
pid        {pid_path};
worker_rlimit_nofile 8192;

{nginx_module_includes}

events {{
  worker_connections 4096;
#  debug_connection 127.0.0.0/8;
}}

http {{
  log_format   main '$remote_addr - $remote_user [$time_local] $status '
    '"$request" $body_bytes_sent "$http_referer" '
    '"$http_user_agent" "$http_x_forwarded_for"';
  access_log   {access_log_path} main;
  sendfile     on;
  tcp_nopush   on;
  tcp_nodelay  on;
  keepalive_timeout 65;
  types_hash_max_size 4096;
  client_body_temp_path {client_body_tmp};
  proxy_temp_path {proxy_temp_path};
  {proxy_cache_path_directive}
  proxy_cache_valid 200 1d;
  proxy_cache_valid any 1m;
  proxy_buffering on;
  fastcgi_temp_path {fastcgi_temp_path};
  uwsgi_temp_path {uwsgi_temp_path};
  scgi_temp_path {scgi_temp_path};
  
  # 修改lua脚本加载路径
  lua_package_path "/usr/local/openresty/nginx/lua/?.lua;{scriptdir}/?.lua;;";

  lua_shared_dict dynredirmap 10m;
  lua_shared_dict cmcd_cfg 1m;
  resolver {resolvers};
  proxy_ssl_server_name on;

  include             {mime_types_file};
  default_type        application/octet-stream;

  server_names_hash_bucket_size 128; # this seems to be required for some vhosts

  init_by_lua_block {{
    dynredir = require "dynamicredirect"
  
    local dict = ngx.shared.cmcd_cfg
    if dict then
      -- 优先使用模板注入的 collector url，若为空，则提供默认的 fallback 地址
      local collector_url = "{cmcd_collector_url}"
	  
      -- 模板引擎可能产生的“假空值”文本
      if collector_url == nil 
         or collector_url == "" 
         or collector_url == "{cmcd_collector_url}" 
         or string.lower(collector_url) == "none" 
         or string.lower(collector_url) == "null" 
         or string.lower(collector_url) == "nil" then
         
        collector_url = "http://192.168.1.111:3000/cmcd/response-mode"
      end
      
      dict:set("cmcd_collector_url", collector_url)
	  
	  -- 查看collector_url
	  ngx.log(ngx.ERR, "[cmcd init] Successfully set collector_url to: ", collector_url)
	
    end
	
    math.randomseed(os.time())

    function re_escape(s)
	  -- 如果传进来的是空值，直接返回空字符串，阻止崩溃！
      if not s then
        return ""
	  end
		
	  if s == "" then
		return ""
	  end
	
	  -- 先转成小写，再判断（确保 s 不是 nil 才调用 string.lower）
	  local lower_s = s:lower()
	  if lower_s == "none" or lower_s == "null" or lower_s == "nil" then
		return ""
	  end
      
      local ret = s:gsub("([]*^[%%.()])", "%%%1")
      return ret
      
    end
  }}

  init_worker_by_lua_block {{
    
	-- package.loaded["cmcd_response_json"] = nil
    -- 使用 pcall 安全加载脚本，防止脚本不存在导致 Nginx 崩溃
    -- local ok, cmcdHandle = pcall(require, "cmcd_response_json")
    -- if ok then
    --   ngx.log(ngx.ERR, "[cmcd] init_worker successfully loaded cmcd_response_json")
    -- else
    --   ngx.log(ngx.ERR, "[cmcd] init_worker failed to load cmcd_response_json: ", cmcdHandle)
    -- end
	
	package.loaded["cmcd_response_json"] = nil
    cmcdHandle = require "cmcd_response_json"
    ngx.log(ngx.ERR, "[cmcd] init_worker loaded type=", type(cmcdHandle))
  }}

{server_configs}

  server {{
    listen       {http_port} default_server;
    listen       [::]:{http_port} default_server;
    server_name  _;
    root         /usr/share/nginx/html;
	
    error_page 404 /404.html;
    location = /404.html {{
    }}

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {{
    }}
  }}
}}